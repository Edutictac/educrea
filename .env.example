# Nombre DNS que apuntará al VPS. No incluya protocolo ni puerto.
EDUCREA_DOMAIN=educrea.edutictac.es
# En desarrollo local solamente:
EDUCREA_DATABASE_URL=postgresql+psycopg://educrea:change-me@localhost:5432/educrea
EDUCREA_COOKIE_SECURE=false
# Solo modelos Gemini verificados como gratuitos para la cuenta y operación.
# Vacío por defecto: la generación permanece deshabilitada.
EDUCREA_GEMINI_FREE_MODELS=
EDUCREA_OPENROUTER_FREE_MODELS=
EDUCREA_GROQ_FREE_MODELS=
EDUCREA_OLLAMA_FREE_MODELS=
# URL interna administrada; no expongas Ollama directamente a Internet.
EDUCREA_OLLAMA_BASE_URL=
# Catálogo de pago verificado por el administrador. Vacío por defecto.
EDUCREA_PAID_MODELS_JSON={}
# Imágenes BYOK: modelos y precios aprobados por el administrador (vacío por defecto).
# Formato: {"gemini":{"gemini-3.1-flash-lite-image":{"1K":{"image_microusd":33600,"input_microusd_per_million":250000}}}}
EDUCREA_IMAGE_MODELS_JSON={}
EDUCREA_AI_DAILY_IMAGE_REQUESTS=20
EDUCREA_IMAGE_REQUEST_TIMEOUT_SECONDS=120
# Images with IA EduCrea for invited accounts (institutional Gemini key with billing enabled).
EDUCREA_INCLUDED_IMAGES_ENABLED=false
EDUCREA_INCLUDED_IMAGE_MODEL=
EDUCREA_INCLUDED_IMAGES_WEEKLY_LIMIT=10
EDUCREA_INCLUDED_IMAGES_GLOBAL_DAILY_LIMIT=50
# Vídeo BYOK con Gemini Omni Flash; vacío por defecto.
# Formato: {"gemini":{"gemini-omni-1.2-flash":{"360p":{"second_microusd":23000},"720p":{"second_microusd":70000},"input_microusd_per_million":1500000}}}
EDUCREA_VIDEO_MODELS_JSON={}
EDUCREA_AI_DAILY_VIDEO_REQUESTS=10
EDUCREA_AI_DAILY_GLOBAL_VIDEO_REQUESTS=0
EDUCREA_VIDEO_REQUEST_TIMEOUT_SECONDS=300
EDUCREA_AI_MAX_USER_BUDGET_MICROUSD=20000000
# Protección contra bucles para proveedores con clave personal (la cuota real la pone el proveedor)
EDUCREA_AI_DAILY_PERSONAL_REQUESTS=200
# Límites del servidor compartido (Ollama)
EDUCREA_AI_DAILY_USER_REQUESTS=20
EDUCREA_AI_DAILY_INSTALLATION_REQUESTS=200
EDUCREA_AI_DAILY_USER_TOKENS=400000
EDUCREA_AI_DAILY_INSTALLATION_TOKENS=4000000


# Inicio de sesión único (OpenID Connect, p. ej. Authentik). Vacío = desactivado.
# La URL de retorno debe registrarse tal cual en el proveedor: https://TU_DOMINIO/api/auth/oidc/callback
EDUCREA_OIDC_ISSUER=
EDUCREA_OIDC_CLIENT_ID=
EDUCREA_OIDC_REDIRECT_URI=
# El secreto del cliente va en un archivo (secrets/oidc_client_secret), nunca aquí.
# false = solo SSO: las cuentas se crean en Authentik y /login redirige allí directamente
EDUCREA_LOCAL_AUTH_ENABLED=false

# IA EduCrea institucional (independiente de BYOK). Importes por millón en USD.
EDUCREA_FREE_AI_ENABLED=false
# Proveedor institucional preferido; si no está configurado se usa el rol de la tarea (qwen/deepseek).
EDUCREA_FREE_AI_PRIMARY_PROVIDER=gemini
EDUCREA_FREE_AI_MONTHLY_CREDITS=10000
# Optional weekly quota instead of monthly credits (Monday 00:00 UTC).
EDUCREA_FREE_AI_WEEKLY_CREDITS=
EDUCREA_FREE_AI_CREDITS_PER_USD=100000
EDUCREA_FREE_AI_MIN_CREDITS_PER_REQUEST=1
EDUCREA_FREE_AI_MINUTE_REQUEST_LIMIT=3
EDUCREA_FREE_AI_HOURLY_REQUEST_LIMIT=10
EDUCREA_FREE_AI_DAILY_REQUEST_LIMIT=20
# Tope de peticiones al día para toda la instalación (0 = sin tope). Necesario con una clave gratuita compartida.
EDUCREA_FREE_AI_GLOBAL_DAILY_REQUEST_LIMIT=200
EDUCREA_FREE_AI_MAX_CONCURRENT_REQUESTS=1
EDUCREA_FREE_AI_MAX_INPUT_TOKENS=32768
EDUCREA_FREE_AI_MAX_CONTEXT_TOKENS=30000
EDUCREA_FREE_AI_MAX_OUTPUT_TOKENS=4096
EDUCREA_FREE_AI_GLOBAL_DAILY_BUDGET_USD=0
EDUCREA_FREE_AI_GLOBAL_MONTHLY_BUDGET_USD=0
EDUCREA_FREE_AI_REQUEST_TIMEOUT_SECONDS=120
EDUCREA_FREE_AI_RESERVATION_TTL_SECONDS=900
EDUCREA_FREE_AI_DEEPSEEK_FALLBACK_TO_QWEN=false
EDUCREA_QWEN_ENABLED=true
EDUCREA_QWEN_MODEL=
EDUCREA_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
EDUCREA_QWEN_INPUT_COST_PER_MILLION=0
EDUCREA_QWEN_OUTPUT_COST_PER_MILLION=0
EDUCREA_DEEPSEEK_ENABLED=true
EDUCREA_DEEPSEEK_MODEL=
EDUCREA_DEEPSEEK_BASE_URL=https://api.deepseek.com
EDUCREA_DEEPSEEK_INPUT_COST_PER_MILLION=0
EDUCREA_DEEPSEEK_OUTPUT_COST_PER_MILLION=0
# Gemini institucional SOLO nivel gratuito: las tarifas deben quedar en 0; los límites son por peticiones.
EDUCREA_GEMINI_ENABLED=true
# Identificador verificado en tu cuenta (en las pruebas funcionó gemini-3.5-flash-lite).
EDUCREA_GEMINI_MODEL=
EDUCREA_GEMINI_INPUT_COST_PER_MILLION=0
EDUCREA_GEMINI_OUTPUT_COST_PER_MILLION=0
# Desarrollo: claves solo en backend; en Docker se leen desde secrets/.
EDUCREA_GEMINI_API_KEY=
EDUCREA_QWEN_API_KEY=
EDUCREA_DEEPSEEK_API_KEY=

# Administración de beta: SMTP solo backend; contraseña fuera de Git.
EDUCREA_PUBLIC_BASE_URL=
EDUCREA_SMTP_HOST=
EDUCREA_SMTP_PORT=587
EDUCREA_SMTP_SECURITY=starttls
EDUCREA_SMTP_USERNAME=
EDUCREA_SMTP_FROM=
EDUCREA_SMTP_PASSWORD=
EDUCREA_BETA_INVITATION_DAYS=7
EDUCREA_BETA_INVITATION_DAILY_LIMIT=50
EDUCREA_BETA_INVITATION_COOLDOWN_SECONDS=300
