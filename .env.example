# Nombre DNS que apuntará al VPS. No incluya protocolo ni puerto.
EDUSTUDIO_DOMAIN=edustudio.example.org
# En desarrollo local solamente:
EDUSTUDIO_DATABASE_URL=postgresql+psycopg://edustudio:change-me@localhost:5432/edustudio
EDUSTUDIO_COOKIE_SECURE=false
# Solo modelos Gemini verificados como gratuitos para la cuenta y operación.
# Vacío por defecto: la generación permanece deshabilitada.
EDUSTUDIO_GEMINI_FREE_MODELS=
EDUSTUDIO_OPENROUTER_FREE_MODELS=
EDUSTUDIO_GROQ_FREE_MODELS=
EDUSTUDIO_OLLAMA_FREE_MODELS=
# URL interna administrada; no expongas Ollama directamente a Internet.
EDUSTUDIO_OLLAMA_BASE_URL=
# Catálogo de pago verificado por el administrador. Vacío por defecto.
EDUSTUDIO_PAID_MODELS_JSON={}
EDUSTUDIO_AI_MAX_USER_BUDGET_MICROUSD=20000000
# Protección contra bucles para proveedores con clave personal (la cuota real la pone el proveedor)
EDUSTUDIO_AI_DAILY_PERSONAL_REQUESTS=200
# Límites del servidor compartido (Ollama)
EDUSTUDIO_AI_DAILY_USER_REQUESTS=20
EDUSTUDIO_AI_DAILY_INSTALLATION_REQUESTS=200
EDUSTUDIO_AI_DAILY_USER_TOKENS=400000
EDUSTUDIO_AI_DAILY_INSTALLATION_TOKENS=4000000

